@prefix bto: <https://w3id.org/brainteaser/ontology/schema/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix genomics: <https://w3id.org/hereditary/ontology/genomics/schema/> .
@prefix gutbrain: <https://w3id.org/hereditary/ontology/gutbrain/schema/> .
@prefix mesh: <https://www.ncbi.nlm.nih.gov/mesh/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix snomed: <http://purl.bioontology.org/ontology/SNOMEDCT/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:Box a rdfs:Datatype .

dcterms:ISO3166 a rdfs:Datatype .

dcterms:ISO639-2 a rdfs:Datatype .

dcterms:ISO639-3 a rdfs:Datatype .

dcterms:Period a rdfs:Datatype .

dcterms:Point a rdfs:Datatype .

dcterms:RFC1766 a rdfs:Datatype .

dcterms:RFC3066 a rdfs:Datatype .

dcterms:RFC4646 a rdfs:Datatype .

dcterms:RFC5646 a rdfs:Datatype .

dcterms:URI a rdfs:Datatype .

dcterms:W3CDTF a rdfs:Datatype .

dcterms:abstract a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:description .

dcterms:accessRights a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:rights .

dcterms:accrualMethod a owl:AnnotationProperty ;
    rdfs:domain dcmitype:Collection .

dcterms:accrualPeriodicity a owl:AnnotationProperty ;
    rdfs:domain dcmitype:Collection .

dcterms:accrualPolicy a owl:AnnotationProperty ;
    rdfs:domain dcmitype:Collection .

dcterms:alternative a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:title .

dcterms:available a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:bibliographicCitation a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier .

dcterms:conformsTo a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:created a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:creator rdfs:label "Creator"@en ;
    dcterms:description "Recommended practice is to identify the creator with a URI.  If this is not possible or feasible, a literal value that identifies the creator may be provided."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making the resource."@en ;
    rdfs:subPropertyOf dcterms:contributor .

dcterms:dateAccepted a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:dateCopyrighted a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:dateSubmitted a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:educationLevel a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:audience .

dcterms:extent a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:format .

dcterms:hasFormat a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:hasPart a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:hasVersion a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:isFormatOf a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:isPartOf a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:isReferencedBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:isReplacedBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:isRequiredBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:isVersionOf a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:issued a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:language a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:rights .

dcterms:mediator a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:audience .

dcterms:medium a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:format .

dcterms:modified a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:publisher a owl:AnnotationProperty .

dcterms:references a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:replaces a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:requires a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:source a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:relation .

dcterms:spatial a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:coverage .

dcterms:subject a owl:AnnotationProperty .

dcterms:tableOfContents a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:description .

dcterms:temporal a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:coverage .

dcterms:type a owl:AnnotationProperty .

dcterms:valid a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

rdfs:Class a owl:Class .

xsd:date a rdfs:Datatype .

gutbrain: a owl:Ontology ;
    rdfs:label "Author: Samuel Piron" ;
    dcterms:creator <https://orcid.org/0000-0003-4970-4554>,
        <https://orcid.org/0009-0001-1596-8642>,
        <https://orcid.org/0009-0006-5558-4295> ;
    dcterms:description "The Hereditary ontology models phenoclinical, genomics and scientific aspects of the gut-brain axis to provide a unifying layer to query different database sources through an Ontology-Based Data Access (OBDA) framework. This part of the ontology focuses on gut-brain data."@en ;
    dcterms:license """Copyright 2024-2027 University of Padua, Italy

Licensed under the

Creative Commons Attribution 4.0 International License
     https://creativecommons.org/licenses/by/4.0/

You may obtain a copy of the License at
     https://creativecommons.org/licenses/by/4.0/legalcode

This work has been supported by the HEREDITARY project
     https://hereditary-project.eu/

     funded by the European Union’s Horizon Europe research and innovation programme 
     under the grant agreement No GA101137074"""@en ;
    dcterms:title "The Hereditary Ontology for GutBrain Data"@en ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    owl:versionIRI <https://w3id.org/hereditary/ontology/gutbrain/1.0/> ;
    owl:versionInfo 1.0 .

gutbrain:ExperimentalResult a owl:Class ;
    rdfs:label "Experimental Result"@en ;
    rdfs:comment "The outcome of an experiment or set of experiments, including observations and primary, processed, and analyzed data. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C76125 .

gutbrain:PaperCollection a owl:Class ;
    rdfs:label "Paper Collection"@en ;
    rdfs:comment "The type of the collection where the papers are stored."@en .

gutbrain:Specimen a owl:Class ;
    rdfs:label "Specimen"@en ;
    rdfs:comment "A material entity that is collected for potential use as an input upon which measurements or observations are performed. [Definition Source: OBI]"@en ;
    skos:exactMatch obo:OBI_0100051 .

gutbrain:SpecimenCollectionProcess a owl:Class ;
    rdfs:label "Specimen Collection Process"@en ;
    rdfs:comment "A planned process with the objective to obtain a material entity for potential use as an input upon which measurements or observations are performed. [Definition Source: OBI]"@en ;
    skos:exactMatch obo:OBI_0000659 .

gutbrain:administered a owl:ObjectProperty ;
    rdfs:label "administered"@en ;
    rdfs:comment "It defines the relationship between the intervention or procedure and the organism."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:InterventionOrProcedure gutbrain:Chemical gutbrain:DietarySupplement gutbrain:Drug gutbrain:Food ) ] ;
    rdfs:range gutbrain:Organism .

gutbrain:affect a owl:ObjectProperty ;
    rdfs:label "affect" ;
    rdfs:comment "It defines a relatioship between a disease and another disease."@en ;
    rdfs:domain bto:DiseaseDisorderOrFinding ;
    rdfs:range bto:DiseaseDisorderOrFinding .

gutbrain:changeAbundance a owl:ObjectProperty ;
    rdfs:label "changeAbundance"@en ;
    rdfs:comment "It defines the relationship between the bacteria or microbiome and te disease, disorder or finding."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:DiseaseDisorderOrFinding bto:InterventionOrProcedure gutbrain:Chemical gutbrain:Drug gutbrain:Food ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( genomics:Species gutbrain:Microbiome ) ] .

gutbrain:changeEffect a owl:ObjectProperty ;
    rdfs:label "changeEffect"@en ;
    rdfs:comment "It indicates that a drug or substance alters or modifies the course or symptoms of a disease or disorder."@en ;
    rdfs:domain gutbrain:Drug ;
    rdfs:range bto:DiseaseDisorderOrFinding .

gutbrain:changeExpression a owl:ObjectProperty ;
    rdfs:label "changeExpression"@en ;
    rdfs:comment "It explains how a bacteria or the microbiome can change the expression of a gene."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:InterventionOrProcedure genomics:Species gutbrain:Chemical gutbrain:DietarySupplement gutbrain:Drug gutbrain:Food gutbrain:Microbiome ) ] ;
    rdfs:range bto:Gene .

gutbrain:comparedTo a owl:ObjectProperty ;
    rdfs:label "comparedTo"@en ;
    rdfs:comment "It defines the relationship between an instance of microbiome and another microbiome."@en ;
    rdfs:domain gutbrain:Microbiome ;
    rdfs:range gutbrain:Microbiome .

gutbrain:composedOf a owl:ObjectProperty ;
    rdfs:label "composedOf"@en ;
    rdfs:comment "This relationship describes the connection between the abstracts and titles and the sentences that compose them."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gutbrain:PaperAbstract gutbrain:PaperTitle ) ] ;
    rdfs:range gutbrain:Sentence .

gutbrain:containedIn a owl:ObjectProperty ;
    rdfs:label "containedIn"@en ;
    rdfs:comment "It describes the relationship between the mention and the sentence and the entities and the mention."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:AnatomicalSite bto:DiseaseDisorderOrFinding bto:Gene bto:InterventionOrProcedure genomics:Assay genomics:Species gutbrain:Animal gutbrain:BiomedicalTechnique gutbrain:Chemical gutbrain:DietarySupplement gutbrain:Drug gutbrain:Food gutbrain:Human gutbrain:Microbiome gutbrain:Organism gutbrain:StatisticalTechnique ) ] .

gutbrain:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment "It explains that each collection is composed of papers."@en ;
    rdfs:domain skos:Collection ;
    rdfs:range gutbrain:Paper .

gutbrain:hasAbstract a owl:ObjectProperty ;
    rdfs:label "hasAbstract"@en ;
    rdfs:comment "It underlines that a paper contains an abstract."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range gutbrain:PaperAbstract .

gutbrain:hasAbstractText a owl:DatatypeProperty ;
    rdfs:label "hasAbstractText"@en ;
    rdfs:comment "The full abstract of the paper as a single text string."@en ;
    rdfs:domain gutbrain:PaperAbstract ;
    rdfs:range rdf:PlainLiteral .

gutbrain:hasMentionText a owl:DatatypeProperty ;
    rdfs:label "hasMentionText"@en ;
    rdfs:comment "The exact text span that was annotated (e.g., the words in the title/abstract that constitute an individual or relation mention)."@en ;
    rdfs:domain gutbrain:Mention ;
    rdfs:range rdf:PlainLiteral .

gutbrain:hasSentenceText a owl:DatatypeProperty ;
    rdfs:label "hasSentenceText"@en ;
    rdfs:comment "The complete sentence from the source document."@en ;
    rdfs:domain gutbrain:Sentence ;
    rdfs:range rdf:PlainLiteral .

gutbrain:hasTitle a owl:ObjectProperty ;
    rdfs:label "hasTitle"@en ;
    rdfs:comment "It underlines that a paper contains a title."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range gutbrain:PaperTitle .

gutbrain:hasTitleText a owl:DatatypeProperty ;
    rdfs:label "hasTitleText"@en ;
    rdfs:comment "The paper’s title as a single text string."@en ;
    rdfs:domain gutbrain:PaperTitle ;
    rdfs:range rdf:PlainLiteral .

gutbrain:impact a owl:ObjectProperty ;
    rdfs:label "impact"@en ;
    rdfs:comment "It describes the effect or change when is strongly associated with alterations in biological or microbiological aspects, like microbiota or gut health."@en ;
    rdfs:domain gutbrain:Drug ;
    rdfs:range gutbrain:Microbiome .

gutbrain:influence a owl:ObjectProperty ;
    rdfs:label "influence"@en ;
    rdfs:comment "Represents the effect or impact of a dietary supplements or other substances and often diseases, disorders, or health conditions."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:InterventionOrProcedure genomics:Species gutbrain:Chemical gutbrain:Drug gutbrain:Food ) ] ;
    rdfs:range bto:DiseaseDisorderOrFinding .

gutbrain:interact a owl:ObjectProperty ;
    rdfs:label "interact"@en ;
    rdfs:comment "It explains what can influence disease, disorder or finding."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:DiseaseDisorderOrFinding genomics:Species gutbrain:Chemical gutbrain:Drug ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( bto:InterventionOrProcedure genomics:Species gutbrain:Chemical gutbrain:Drug gutbrain:Food ) ] .

gutbrain:isA a owl:ObjectProperty ;
    rdfs:label "isA"@en ;
    rdfs:comment "It defines a relatioship between a disease and another disease."@en ;
    rdfs:domain bto:DiseaseDisorderOrFinding ;
    rdfs:range bto:DiseaseDisorderOrFinding .

gutbrain:isLinkedTo a owl:ObjectProperty ;
    rdfs:label "isLinkedTo"@en ;
    rdfs:comment "It defines a relatioship between microbiota and a disease or health condition."@en ;
    rdfs:domain gutbrain:Microbiome ;
    rdfs:range bto:DiseaseDisorderOrFinding .

gutbrain:locatedIn a owl:ObjectProperty ;
    rdfs:label "locatedIn"@en ;
    rdfs:comment "It defines the relationship between an organism and its location in the Microbiome."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:AnatomicalSite gutbrain:Chemical gutbrain:Mention gutbrain:Microbiome ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( bto:AnatomicalSite gutbrain:Organism gutbrain:Sentence ) ] .

gutbrain:paperAnnotator a owl:DatatypeProperty ;
    rdfs:label "paperAnnotator"@en ;
    rdfs:comment "The identifier of the expert who annotated the paper (e.g., expert_7)."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range rdf:PlainLiteral .

gutbrain:paperAuthor a owl:DatatypeProperty ;
    rdfs:label "paperAuthor"@en ;
    rdfs:comment "The author list for the paper."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range rdf:PlainLiteral .

gutbrain:paperId a owl:DatatypeProperty ;
    rdfs:label "paperId"@en ;
    rdfs:comment "The unique paper identifier in your corpus (e.g., PubMed ID)."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range xsd:integer .

gutbrain:paperJournal a owl:DatatypeProperty ;
    rdfs:label "paperJournal"@en ;
    rdfs:comment "The journal where the paper was published."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range rdf:PlainLiteral .

gutbrain:paperYear a owl:DatatypeProperty ;
    rdfs:label "paperYear"@en ;
    rdfs:comment "The publication year of the paper."@en ;
    rdfs:domain gutbrain:Paper ;
    rdfs:range xsd:gYear .

gutbrain:partOf a owl:ObjectProperty ;
    rdfs:label "partOf"@en ;
    rdfs:comment "It defines the relationship between bacterias that are part of microbiota and microbiome."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( bto:Gene genomics:Species gutbrain:Genome gutbrain:Metabolite gutbrain:Microbiome gutbrain:Sentence ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( gutbrain:Chemical gutbrain:Genome gutbrain:Microbiome gutbrain:Microbiota gutbrain:PaperAbstract gutbrain:PaperTitle ) ] .

gutbrain:producedBy a owl:ObjectProperty ;
    rdfs:label "producedBy"@en ;
    rdfs:comment "It defines the relationship between the drug or metabolite and the microbiome."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gutbrain:Drug gutbrain:Metabolite ) ] ;
    rdfs:range gutbrain:Microbiome .

gutbrain:relatedTo a owl:ObjectProperty ;
    rdfs:label "relatedTo"@en ;
    rdfs:comment "It defines the relationship between the neurotransmitter and the microbiome."@en ;
    rdfs:domain gutbrain:Neurotransmitter ;
    rdfs:range gutbrain:Microbiome .

gutbrain:strike a owl:ObjectProperty ;
    rdfs:label "strike"@en ;
    rdfs:comment "It defines the relationship between the disease, disorder and finding and the anatomical location."@en ;
    rdfs:domain bto:DiseaseDisorderOrFinding ;
    rdfs:range bto:AnatomicalSite .

gutbrain:taggedAs a owl:DatatypeProperty ;
    rdfs:label "taggedAs"@en ;
    rdfs:comment "One or more human-readable tags assigned to a mention or paper (e.g., drug, bacteria, DDF), mirroring the category."@en ;
    rdfs:domain gutbrain:Mention ;
    rdfs:range rdf:PlainLiteral .

gutbrain:target a owl:ObjectProperty ;
    rdfs:label "target"@en ;
    rdfs:comment "It is used to specify that a particular disease or health disorder primarily affects or concerns a specific population or biological entity."@en ;
    rdfs:domain bto:DiseaseDisorderOrFinding ;
    rdfs:range gutbrain:Organism .

gutbrain:treatedBy a owl:ObjectProperty ;
    rdfs:label "treatedBy"@en ;
    rdfs:comment "It explains that the disease, disorder or finding is treated by the intervention or procedure."@en ;
    rdfs:domain bto:DiseaseDisorderOrFinding ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( bto:InterventionOrProcedure gutbrain:Chemical gutbrain:Drug gutbrain:Food ) ] .

gutbrain:usedBy a owl:ObjectProperty ;
    rdfs:label "usedBy"@en ;
    rdfs:comment "This relationship suggests the employment or use of specific biomedical techniques or methods on particular biological entities, usually in experimental setups."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gutbrain:Animal gutbrain:Human gutbrain:Microbiome ) ] ;
    rdfs:range gutbrain:BiomedicalTechnique .

dcterms:contributor rdfs:label "Contributor"@en ;
    dcterms:description "The guidelines for using names of persons or organizations as creators apply to contributors."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en .

dcterms:identifier a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

dcterms:title a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

xsd:gYear a rdfs:Datatype .

gutbrain:Class a owl:Class ;
    rdfs:label "Class"@en ;
    rdfs:comment "A collection of taxonomic subdivisions directly under Phylum. It is a major group of organisms, e.g. Mammalia, Reptilia, Gastropoda, Insecta, etc that contains a large number of different sublineages, but have shared characteristics in common (e.g. warm-blooded, fur, six legs etc). [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Phylum ;
    skos:exactMatch obo:NCIT_C45280 .

gutbrain:Domain a owl:Class ;
    rdfs:label "Domain"@en ;
    rdfs:comment "A taxonomic category above that of Kingdom."@en ;
    skos:exactMatch obo:NCIT_C62706 .

gutbrain:Family a owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:comment "A taxonomic category between Order and Genus. It consists of a group of organisms among which the differences are quite minor, e.g. Equiidae - horses and their relatives. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Order ;
    skos:exactMatch obo:NCIT_C45290 .

gutbrain:Genus a owl:Class ;
    rdfs:label "Genus"@en ;
    rdfs:comment "A taxonomic category ranking below a family (or Subfamily) and above a species and generally consisting of a group of species exhibiting similar characteristics. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Family ;
    skos:exactMatch obo:NCIT_C45292 .

gutbrain:Microbiota a owl:Class ;
    rdfs:label "Microbiota"@en ;
    rdfs:comment "Microbiota are the range of microorganisms that may be commensal, mutualistic, or pathogenic found in and on all multicellular organisms, including plants. [Definition Source: Wikipedia]"@en ;
    skos:exactMatch obo:NCIT_C93019 .

gutbrain:Neurotransmitter a owl:Class ;
    rdfs:label "Neurotransmitter"@en ;
    rdfs:comment "Endogenous signaling molecules that alter the behavior of neurons or effector cells. Neurotransmitter is used here in its most general sense, including not only messengers that act directly to regulate ion channels, but also those that act through second messenger systems, and those that act at a distance from their site of release. Included are neuromodulators, neuroregulators, neuromediators, and neurohumors, whether or not acting at synapses. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C687 .

gutbrain:Order a owl:Class ;
    rdfs:label "Order"@en ;
    rdfs:comment "A taxonomic category between Class and Family. It is group of organisms that although differing quite a bit among themselves still have a large degree of characteristics in common. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Class ;
    skos:exactMatch obo:NCIT_C45287 .

gutbrain:Phylum a owl:Class ;
    rdfs:label "Phylum"@en ;
    rdfs:comment "A major division of a biological kingdom, consisting of closely-related classes; represents a basic fundamental pattern of organization and, presumably, a common descent. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:SuperKingdom ;
    skos:exactMatch obo:NCIT_C45277 .

gutbrain:StatisticalTechnique a owl:Class ;
    rdfs:label "Statistical Technique"@en ;
    rdfs:comment "A method of calculating, analyzing, or representing statistical data. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf genomics:Assay ;
    skos:exactMatch obo:NCIT_C19044 .

gutbrain:SuperKingdom a owl:Class ;
    rdfs:label "Super Kingdom"@en ;
    rdfs:comment "The highest taxonomic rank, immediately above phylum or division. There are five biological kingdoms (Monera, Protista, Plantae, Fungi, Animalia) into which organisms are grouped, based on common characteristics. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Domain ;
    skos:exactMatch obo:NCIT_C45276 .

dcterms:audience a owl:AnnotationProperty .

dcterms:coverage a owl:AnnotationProperty .

dcterms:description rdfs:label "Description"@en ;
    dcterms:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An account of the resource."@en .

dcterms:format a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

gutbrain:Animal a owl:Class ;
    rdfs:label "Animal"@en ;
    rdfs:comment "A non-human living organism that has membranous cell walls, requires oxygen and organic foods, and is capable of voluntary movement, as distinguished from a plant or mineral. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Organism ;
    skos:exactMatch obo:NCIT_C14182 .

gutbrain:BiomedicalTechnique a owl:Class ;
    rdfs:label "Biomedical Technique"@en ;
    rdfs:comment "Research concerned with the application of biological and physiological principles to clinical medicine. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf genomics:Assay ;
    skos:exactMatch obo:NCIT_C15188 .

gutbrain:Food a owl:Class ;
    rdfs:label "Food"@en ;
    rdfs:comment "A group of materials of either plant, animal or artificial origin containing essential body nutrients that can be ingested by an organism to produce energy, stimulate growth, and maintain life. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C62695 .

gutbrain:Genome a owl:Class ;
    rdfs:label "Genome"@en ;
    rdfs:comment "The genetic complement of an organism, including all of its GENES, as represented in its DNA, or in some cases, its RNA. [Definition Source: MeSH]"@en ;
    skos:exactMatch mesh:68016678 .

gutbrain:Human a owl:Class ;
    rdfs:label "Human"@en ;
    rdfs:comment "Members of the species Homo sapiens. [Definition Source: NCBI]"@en ;
    rdfs:subClassOf gutbrain:Organism ;
    skos:exactMatch obo:NCBITaxon_9606 .

gutbrain:Metabolite a owl:Class ;
    rdfs:label "Metabolite"@en ;
    rdfs:comment "Any substance involved in metabolism, either as a product of metabolism or as necessary for metabolism. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:CHEBI_25212 .

bto:Gene a owl:Class ;
    rdfs:label "Gene"@en ;
    rdfs:comment "A functional unit of heredity which occupies a specific position on a particular chromosome and serves as the template for a product that contributes to a phenotype or a biological function. [Definition Source: NCIT]"@en ;
    skos:exactMatch snomed:67271001 .

genomics:Assay a owl:Class ;
    rdfs:label "Assay"@en ;
    rdfs:comment "The assay used to produce measurement. [Definition Source: Phenopacket v2]"@en ;
    skos:exactMatch obo:OBI_0000070 .

gutbrain:DietarySupplement a owl:Class ;
    rdfs:label "Dietary Supplement"@en ;
    rdfs:comment "Oral preparations containing dietary ingredient(s) intended to supplement the diet. Dietary ingredients include vitamins, minerals, herbs, amino acids, extracts and metabolites. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Food ;
    skos:exactMatch obo:NCIT_C1505 .

gutbrain:Mention a owl:Class ;
    rdfs:label "Mention"@en ;
    rdfs:comment "Word or Phrase that is inside a sentence."@en .

bto:AnatomicalSite a owl:Class ;
    rdfs:label "Anatomic Site"@en ;
    rdfs:comment "Named locations of or within the body. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C13717 .

gutbrain:Chemical a owl:Class ;
    rdfs:label "Chemical"@en ;
    rdfs:comment "A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types. [Definition Source: CHEBI]"@en ;
    skos:exactMatch obo:CHEBI_59999 .

gutbrain:PaperAbstract a owl:Class ;
    rdfs:label "Paper Abstract"@en ;
    rdfs:comment "A written summary of the important points of a scientific article. [Definition Source: NCIT]"@en .

gutbrain:PaperTitle a owl:Class ;
    rdfs:label "Paper Title"@en ;
    rdfs:comment "An official descriptive name of a document, e.g. the long name of a study protocol provided by the study sponsor. [Definition Source: NCIT]"@en .

gutbrain:Sentence a owl:Class ;
    rdfs:label "Sentence"@en ;
    rdfs:comment "A set of words that is complete in itself, conveying a statement, question, exclamation, or command and typically containing an explicit or implied subject and a predicate containing a finite verb. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C62638 .

gutbrain:Drug a owl:Class ;
    rdfs:label "Drug"@en ;
    rdfs:comment "Any substance which when absorbed into a living organism may modify one or more of its functions. The term is generally accepted for a substance taken for a therapeutic purpose, but is also commonly used for abused substances. [Definition Source: CHEBI]"@en ;
    skos:exactMatch obo:CHEBI_23888 .

gutbrain:Organism a owl:Class ;
    rdfs:label "Organism"@en ;
    rdfs:comment "A living entity. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C14250 .

genomics:Species a owl:Class ;
    rdfs:label "Species"@en ;
    rdfs:comment "A group of organisms that differ from all other groups of organisms and that are capable of breeding and producing fertile offspring. [Definition Source: NCIT]"@en ;
    rdfs:subClassOf gutbrain:Genus ;
    skos:exactMatch obo:NCIT_C45293 .

dcterms:date a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

gutbrain:Paper a owl:Class ;
    rdfs:label "Paper"@en ;
    rdfs:comment "An article reporting original research, published in a peer-reviewed journal. [Definition Source: ONTOAVIDA]"@en .

bto:InterventionOrProcedure a owl:Class ;
    rdfs:label "Intervention or Procedure"@en ;
    rdfs:comment "An activity that produces an effect, or that is intended to alter the course of a disease in a patient or population. This is a general term that encompasses the medical, social, behavioral, and environmental acts that can have preventive, therapeutic, or palliative effects. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C25218 .

bto:DiseaseDisorderOrFinding a owl:Class ;
    rdfs:label "Disease, Disorder or Finding"@en ;
    rdfs:comment "A condition that is relevant to human neoplasms and non-neoplastic disorders. This includes observations, test results, history and other concepts relevant to the characterization of human pathologic conditions. [Definition Source: NCIT]"@en ;
    skos:exactMatch obo:NCIT_C7057 .

gutbrain:Microbiome a owl:Class ;
    rdfs:label "Microbiome"@en ;
    rdfs:comment "This term refers to the entire habitat, including the microorganisms (bacteria, archaea, lower and higher eukaryotes, and viruses), their genomes (i.e., genes), and the surrounding environmental conditions. [Definition Source: OHMI]"@en ;
    skos:exactMatch obo:OHMI_0000003 .

dcterms:relation a owl:AnnotationProperty .

