                                                                                            )
                                                                              ] ;
                                                                  rdfs:range <https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiome> ;
                                                                  rdfs:comment "It defines the relationship between the drug or metabolite and the microbiome."@en ;
                                                                  rdfs:label "producedBy"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/relatedTo
<https://w3id.org/hereditary/ontology/gutbrain/schema/relatedTo> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Neurotransmitter> ;
                                                                 rdfs:range <https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiome> ;
                                                                 rdfs:comment "It defines the relationship between the neurotransmitter and the microbiome."@en ;
                                                                 rdfs:label "relatedTo"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/strike
<https://w3id.org/hereditary/ontology/gutbrain/schema/strike> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                                              rdfs:range <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                                              rdfs:comment "It defines the relationship between the disease, disorder and finding and the anatomical location."@en ;
                                                              rdfs:label "strike"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/target
<https://w3id.org/hereditary/ontology/gutbrain/schema/target> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                                              rdfs:range <https://w3id.org/hereditary/ontology/gutbrain/schema/Organism> ;
                                                              rdfs:comment "It is used to specify that a particular disease or health disorder primarily affects or concerns a specific population or biological entity."@en ;
                                                              rdfs:label "target"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/treatedBy
<https://w3id.org/hereditary/ontology/gutbrain/schema/treatedBy> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                                                 rdfs:range <https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure> ;
                                                                 rdfs:comment "It explains that the disease, disorder or finding is treated by the intervention or procedure."@en ;
                                                                 rdfs:label "treatedBy"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/usedBy
<https://w3id.org/hereditary/ontology/gutbrain/schema/usedBy> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain [ rdf:type owl:Class ;
                                                                            owl:unionOf ( <https://w3id.org/hereditary/ontology/gutbrain/schema/Animal>
                                                                                          <https://w3id.org/hereditary/ontology/gutbrain/schema/Human>
                                                                                          <https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiome>
                                                                                        )
                                                                          ] ;
                                                              rdfs:range <https://w3id.org/hereditary/ontology/gutbrain/schema/BiomedicalTechnique> ;
                                                              rdfs:comment "This relationship suggests the employment or use of specific biomedical techniques or methods on particular biological entities, usually in experimental setups."@en ;
                                                              rdfs:label "usedBy"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/alternative
<http://purl.org/dc/terms/alternative> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf <http://purl.org/dc/terms/title> .


###  http://purl.org/dc/terms/available
<http://purl.org/dc/terms/available> rdf:type owl:DatatypeProperty ;
                                     rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:DatatypeProperty ;
                                                 rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/date
<http://purl.org/dc/terms/date> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/dateAccepted
<http://purl.org/dc/terms/dateAccepted> rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/dateCopyrighted
<http://purl.org/dc/terms/dateCopyrighted> rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/dateSubmitted
<http://purl.org/dc/terms/dateSubmitted> rdf:type owl:DatatypeProperty ;
                                         rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ;
                                 rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/valid
<http://purl.org/dc/terms/valid> rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf <http://purl.org/dc/terms/date> .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/hasAbstractText
<https://w3id.org/hereditary/ontology/gutbrain/schema/hasAbstractText> rdf:type owl:DatatypeProperty ;
                                                                       rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/PaperAbstract> ;
                                                                       rdfs:range rdf:PlainLiteral ;
                                                                       rdfs:comment "The full abstract of the paper as a single text string."@en ;
                                                                       rdfs:label "hasAbstractText"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/hasMentionText
<https://w3id.org/hereditary/ontology/gutbrain/schema/hasMentionText> rdf:type owl:DatatypeProperty ;
                                                                      rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Mention> ;
                                                                      rdfs:range rdf:PlainLiteral ;
                                                                      rdfs:comment "The exact text span that was annotated (e.g., the words in the title/abstract that constitute an individual or relation mention)."@en ;
                                                                      rdfs:label "hasMentionText"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/hasSentenceText
<https://w3id.org/hereditary/ontology/gutbrain/schema/hasSentenceText> rdf:type owl:DatatypeProperty ;
                                                                       rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Sentence> ;
                                                                       rdfs:range rdf:PlainLiteral ;
                                                                       rdfs:comment "The complete sentence from the source document."@en ;
                                                                       rdfs:label "hasSentenceText"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/hasTitleText
<https://w3id.org/hereditary/ontology/gutbrain/schema/hasTitleText> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/PaperTitle> ;
                                                                    rdfs:range rdf:PlainLiteral ;
                                                                    rdfs:comment "The paper’s title as a single text string."@en ;
                                                                    rdfs:label "hasTitleText"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/paperAnnotator
<https://w3id.org/hereditary/ontology/gutbrain/schema/paperAnnotator> rdf:type owl:DatatypeProperty ;
                                                                      rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Paper> ;
                                                                      rdfs:range rdf:PlainLiteral ;
                                                                      rdfs:comment "The identifier of the expert who annotated the paper (e.g., expert_7)."@en ;
                                                                      rdfs:label "paperAnnotator"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/paperAuthor
<https://w3id.org/hereditary/ontology/gutbrain/schema/paperAuthor> rdf:type owl:DatatypeProperty ;
                                                                   rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Paper> ;
                                                                   rdfs:range rdf:PlainLiteral ;
                                                                   rdfs:comment "The author list for the paper."@en ;
                                                                   rdfs:label "paperAuthor"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/paperId
<https://w3id.org/hereditary/ontology/gutbrain/schema/paperId> rdf:type owl:DatatypeProperty ;
                                                               rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Paper> ;
                                                               rdfs:range xsd:integer ;
                                                               rdfs:comment "The unique paper identifier in your corpus (e.g., PubMed ID)."@en ;
                                                               rdfs:label "paperId"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/paperJournal
<https://w3id.org/hereditary/ontology/gutbrain/schema/paperJournal> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Paper> ;
                                                                    rdfs:range rdf:PlainLiteral ;
                                                                    rdfs:comment "The journal where the paper was published."@en ;
                                                                    rdfs:label "paperJournal"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/paperYear
<https://w3id.org/hereditary/ontology/gutbrain/schema/paperYear> rdf:type owl:DatatypeProperty ;
                                                                 rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Paper> ;
                                                                 rdfs:range xsd:gYear ;
                                                                 rdfs:comment "The publication year of the paper."@en ;
                                                                 rdfs:label "paperYear"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/taggedAs
<https://w3id.org/hereditary/ontology/gutbrain/schema/taggedAs> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <https://w3id.org/hereditary/ontology/gutbrain/schema/Mention> ;
                                                                rdfs:range rdf:PlainLiteral ;
                                                                rdfs:comment "One or more human-readable tags assigned to a mention or paper (e.g., drug, bacteria, DDF), mirroring the category."@en ;
                                                                rdfs:label "taggedAs"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#Class
rdfs:Class rdf:type owl:Class .


###  https://w3id.org/brainteaser/ontology/schema/AnatomicalSite
<https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> rdf:type owl:Class ;
                                                              rdfs:comment "Named locations of or within the body. [Definition Source: NCIT]"@en ;
                                                              rdfs:label "Anatomic Site"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C13717" .


###  https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding
<https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> rdf:type owl:Class ;
                                                                        rdfs:comment "A condition that is relevant to human neoplasms and non-neoplastic disorders. This includes observations, test results, history and other concepts relevant to the characterization of human pathologic conditions. [Definition Source: NCIT]"@en ;
                                                                        rdfs:label "Disease, Disorder or Finding"@en ;
                                                                        <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C7057" .


###  https://w3id.org/brainteaser/ontology/schema/Gene
<https://w3id.org/brainteaser/ontology/schema/Gene> rdf:type owl:Class ;
                                                    rdfs:comment "A functional unit of heredity which occupies a specific position on a particular chromosome and serves as the template for a product that contributes to a phenotype or a biological function. [Definition Source: NCIT]"@en ;
                                                    rdfs:label "Gene"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.bioontology.org/ontology/SNOMEDCT/67271001" .


###  https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure
<https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure> rdf:type owl:Class ;
                                                                       rdfs:comment "An activity that produces an effect, or that is intended to alter the course of a disease in a patient or population. This is a general term that encompasses the medical, social, behavioral, and environmental acts that can have preventive, therapeutic, or palliative effects. [Definition Source: NCIT]"@en ;
                                                                       rdfs:label "Intervention or Procedure"@en ;
                                                                       <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C25218" .


###  https://w3id.org/hereditary/ontology/genomics/schema/Assay
<https://w3id.org/hereditary/ontology/genomics/schema/Assay> rdf:type owl:Class ;
                                                             rdfs:comment "The assay used to produce measurement. [Definition Source: Phenopacket v2]"@en ;
                                                             rdfs:isDefinedBy "http://purl.obolibrary.org/obo/OBI_0000070" ;
                                                             rdfs:label "Assay"@en .


###  https://w3id.org/hereditary/ontology/genomics/schema/Species
<https://w3id.org/hereditary/ontology/genomics/schema/Species> rdf:type owl:Class ;
                                                               rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Genus> ;
                                                               rdfs:comment "A group of organisms that differ from all other groups of organisms and that are capable of breeding and producing fertile offspring. [Definition Source: NCIT]"@en ;
                                                               rdfs:label "Species"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#exactMatch> "http://edamontology.org/data_1045" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Animal
<https://w3id.org/hereditary/ontology/gutbrain/schema/Animal> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Organism> ;
                                                              rdfs:comment "A non-human living organism that has membranous cell walls, requires oxygen and organic foods, and is capable of voluntary movement, as distinguished from a plant or mineral. [Definition Source: NCIT]"@en ;
                                                              rdfs:label "Animal"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C14182" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/BiomedicalTechnique
<https://w3id.org/hereditary/ontology/gutbrain/schema/BiomedicalTechnique> rdf:type owl:Class ;
                                                                           rdfs:subClassOf <https://w3id.org/hereditary/ontology/genomics/schema/Assay> ;
                                                                           rdfs:comment "Research concerned with the application of biological and physiological principles to clinical medicine. [Definition Source: NCIT]"@en ;
                                                                           rdfs:label "Biomedical Technique"@en ;
                                                                           <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C15188" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Chemical
<https://w3id.org/hereditary/ontology/gutbrain/schema/Chemical> rdf:type owl:Class ;
                                                                rdfs:subClassOf <https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure> ;
                                                                rdfs:comment "A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types. [Definition Source: CHEBI]"@en ;
                                                                rdfs:label "Chemical"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/CHEBI_59999" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Class
<https://w3id.org/hereditary/ontology/gutbrain/schema/Class> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Phylum> ;
                                                             rdfs:comment "A collection of taxonomic subdivisions directly under Phylum. It is a major group of organisms, e.g. Mammalia, Reptilia, Gastropoda, Insecta, etc that contains a large number of different sublineages, but have shared characteristics in common (e.g. warm-blooded, fur, six legs etc). [Definition Source: NCIT]"@en ;
                                                             rdfs:label "Class"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C45280" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/DietarySupplement
<https://w3id.org/hereditary/ontology/gutbrain/schema/DietarySupplement> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Food> ;
                                                                         rdfs:comment "Oral preparations containing dietary ingredient(s) intended to supplement the diet. Dietary ingredients include vitamins, minerals, herbs, amino acids, extracts and metabolites. [Definition Source: NCIT]"@en ;
                                                                         rdfs:label "Dietary Supplement"@en ;
                                                                         <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C1505" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Domain
<https://w3id.org/hereditary/ontology/gutbrain/schema/Domain> rdf:type owl:Class ;
                                                              rdfs:comment "A taxonomic category above that of Kingdom."@en ;
                                                              rdfs:label "Domain"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C62706" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Drug
<https://w3id.org/hereditary/ontology/gutbrain/schema/Drug> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure> ;
                                                            rdfs:comment "Any substance which when absorbed into a living organism may modify one or more of its functions. The term is generally accepted for a substance taken for a therapeutic purpose, but is also commonly used for abused substances. [Definition Source: CHEBI]"@en ;
                                                            rdfs:label "Drug"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/CHEBI_23888" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/ExperimentalResult
<https://w3id.org/hereditary/ontology/gutbrain/schema/ExperimentalResult> rdf:type owl:Class ;
                                                                          rdfs:comment "The outcome of an experiment or set of experiments, including observations and primary, processed, and analyzed data. [Definition Source: NCIT]"@en ;
                                                                          rdfs:label "Experimental Result"@en ;
                                                                          <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C76125" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Family
<https://w3id.org/hereditary/ontology/gutbrain/schema/Family> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Order> ;
                                                              rdfs:comment "A taxonomic category between Order and Genus. It consists of a group of organisms among which the differences are quite minor, e.g. Equiidae - horses and their relatives. [Definition Source: NCIT]"@en ;
                                                              rdfs:label "Family"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C45290" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Food
<https://w3id.org/hereditary/ontology/gutbrain/schema/Food> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure> ;
                                                            rdfs:comment "A functional unit of heredity which occupies a specific position on a particular chromosome and serves as the template for a product that contributes to a phenotype or a biological function. [Definition Source: SNOMEDCT]"@en ;
                                                            rdfs:label "Food"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.bioontology.org/ontology/SNOMEDCT/67271001" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Genome
<https://w3id.org/hereditary/ontology/gutbrain/schema/Genome> rdf:type owl:Class ;
                                                              rdfs:comment "The genetic complement of an organism, including all of its GENES, as represented in its DNA, or in some cases, its RNA. [Definition Source: MeSH]"@en ;
                                                              rdfs:label "Genome"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.ncbi.nlm.nih.gov/mesh/68016678" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Genus
<https://w3id.org/hereditary/ontology/gutbrain/schema/Genus> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Family> ;
                                                             rdfs:comment "A taxonomic category ranking below a family (or Subfamily) and above a species and generally consisting of a group of species exhibiting similar characteristics. [Definition Source: NCIT]"@en ;
                                                             rdfs:label "Genus"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C45292" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Human
<https://w3id.org/hereditary/ontology/gutbrain/schema/Human> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Organism> ;
                                                             rdfs:comment "Members of the species Homo sapiens. [Definition Source: NCBI]"@en ;
                                                             rdfs:label "Human"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCBITaxon_9606" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Mention
<https://w3id.org/hereditary/ontology/gutbrain/schema/Mention> rdf:type owl:Class ;
                                                               rdfs:comment "Word or Phrase that is inside a sentence."@en ;
                                                               rdfs:label "Mention"@en .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Metabolite
<https://w3id.org/hereditary/ontology/gutbrain/schema/Metabolite> rdf:type owl:Class ;
                                                                  rdfs:comment "Any substance involved in metabolism, either as a product of metabolism or as necessary for metabolism. [Definition Source: NCIT]"@en ;
                                                                  rdfs:label "Metabolite"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/CHEBI:25212" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiome
<https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiome> rdf:type owl:Class ;
                                                                  rdfs:comment "This term refers to the entire habitat, including the microorganisms (bacteria, archaea, lower and higher eukaryotes, and viruses), their genomes (i.e., genes), and the surrounding environmental conditions. [Definition Source: OHMI]"@en ;
                                                                  rdfs:label "Microbiome"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/OHMI_0000003" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiota
<https://w3id.org/hereditary/ontology/gutbrain/schema/Microbiota> rdf:type owl:Class ;
                                                                  rdfs:comment "Microbiota are the range of microorganisms that may be commensal, mutualistic, or pathogenic found in and on all multicellular organisms, including plants. [Definition Source: Wikipedia]"@en ;
                                                                  rdfs:label "Microbiota"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C93019" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Neurotransmitter
<https://w3id.org/hereditary/ontology/gutbrain/schema/Neurotransmitter> rdf:type owl:Class ;
                                                                        rdfs:comment "Endogenous signaling molecules that alter the behavior of neurons or effector cells. Neurotransmitter is used here in its most general sense, including not only messengers that act directly to regulate ion channels, but also those that act through second messenger systems, and those that act at a distance from their site of release. Included are neuromodulators, neuroregulators, neuromediators, and neurohumors, whether or not acting at synapses. [Definition Source: NCIT]"@en ;
                                                                        rdfs:label "Neurotransmitter"@en ;
                                                                        <http://www.w3.org/2004/02/skos/core#exactMatch> "http://purl.obolibrary.org/obo/NCIT_C687" .


###  https://w3id.org/hereditary/ontology/gutbrain/schema/Order
<https://w3id.org/hereditary/ontology/gutbrain/schema/Order> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/hereditary/ontology/gutbrain/schema/Class> ;
                                                             rdfs:comment "A taxonomic category between Class and Family. It is group of organisms that although differing quite a bit among themselves still have a large degree of characteristics in common. [Definition Source: NCIT]"@en ;
